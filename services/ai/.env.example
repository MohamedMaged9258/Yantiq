# services/ai — MSA inference service configuration
#
# Copy to `.env` and adjust. `.env` is gitignored; this template is not.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# IMPORTANT: this file is NOT loaded automatically.
#
# `MSASettings` (src/quran_muaalem/msa/settings.py) sets env_prefix="MSA_" but
# does not set `env_file`, and nothing in the package calls load_dotenv(). So a
# `.env` sitting next to this template has no effect on its own — the variables
# must be exported into the process environment:
#
#   PowerShell:  $env:MSA_DEVICE = "cpu"
#   bash:        export MSA_DEVICE=cpu
#   or:          set -a; . ./.env; set +a
#
# Wiring `.env` up properly is a tracked follow-up; until then, treat this file
# as documentation of the available variables and their defaults.
# ---------------------------------------------------------------------------

# Path to the checkpoint directory to serve. Relative paths resolve against the
# current working directory, so run the service from `services/ai`.
# The directory must contain preprocessor_config.json alongside config.json and
# model.safetensors, or the feature extractor fails to load.
MSA_MODEL_PATH=checkpoints/msa_model_v1/best_model

# cpu | cuda. Defaults to cuda in code and falls back to cpu automatically when
# CUDA is unavailable.
MSA_DEVICE=cpu

# Audio sample rate the model expects. Do not change without retraining.
MSA_SAMPLE_RATE=16000

# API bind address and port.
MSA_API_HOST=0.0.0.0
MSA_API_PORT=8010

# Where the Gradio UI looks for the API.
MSA_API_URL=http://127.0.0.1:8010

# UI bind address and port.
MSA_UI_HOST=0.0.0.0
MSA_UI_PORT=7870
