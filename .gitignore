# ---------------------------------------------------------------------------
# Yantiq monorepo .gitignore
# Layout: apps/ services/ contracts/ infra/ docs/ prototype-archive/
# See docs/phase-0-baseline.md §15.3 for the cleanup rules this encodes.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
out/
.expo/
.vite/

# Environment variables — templates must stay tracked
.env
.env.local
.env.*.local
!.env.example

# Logs
logs/
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.vscode/
.idea/
*.iml
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
venv/
.venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Jupyter
.ipynb_checkpoints/

# ML artifacts — never commit weights, checkpoints, or datasets.
# The directory rules matter: without them a checkpoint's config.json and
# preprocessor_config.json are still committable even though the weights aren't.
# NOTE: services/ai keys "is this a local path?" off the literal name
# `checkpoints` (src/quran_muaalem/data/msa_dataset.py) — do not rename it.
checkpoints/
datasets/
*.bin
*.pt
*.pth
*.safetensors
*.ckpt
*.gguf
